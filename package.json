{
  "name": "spriteguard",
  "version": "1.0.0",
  "description": "Autonomous, zero-trust Pull Request security engineer powered by Fly.io Sprites, Claude Opus and Neon pgvector.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fly/sprites": "^0.2.5",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "diff": "^9.0.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
