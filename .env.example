# ==============================================================================
# SpriteGuard Environment Configuration
# ==============================================================================

# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Optional public URL shown in GitHub PR comments (e.g. https://spriteguard.fly.dev)
PUBLIC_URL=
# Optional bearer token required for GET /api/scans & /api/scans/:id
DASHBOARD_TOKEN=

# --- Local Demo vs Production Isolation ---
# Set LOCAL_SANDBOX_MODE=true to test the full audit -> patch -> verify -> approve -> dashboard
# pipeline locally using the local sandbox driver & in-memory GitHub/store fallbacks.
# Set LOCAL_SANDBOX_MODE=false in production to require Neon Postgres, Claude Opus,
# Fly.io Sprites, and split GitHub credentials.
LOCAL_SANDBOX_MODE=true
LOCAL_ALLOW_UNTRUSTED_EXEC=false

# --- AI Security Auditor (Layer C, Patch Generator, PR Q&A) ---
# Privacy guarantee: RedactionVault redacts detected secret literals BEFORE any prompt
# leaves the server. For full local/air-gapped privacy, use Local Ollama or Zero-AI mode.
#
# Routing precedence:
#   1. If LLM_BASE_URL is set     -> uses any OpenAI-compatible /chat/completions endpoint
#   2. Else if ANTHROPIC_API_KEY  -> uses Anthropic Claude directly via native SDK
#   3. Else                       -> Zero-AI deterministic mode (Layer A/B + built-in fallback)
#
# Option 1 — Local Ollama (100% local on your machine; on Fly.io, localhost refers to the Fly VM
#            unless exposed via a tunnel or hosted endpoint):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5-coder
#
# Option 2 — OpenRouter (open-source & multi-model routing):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=your-key
#   LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
#
# Option 3 — Google Gemini (OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=your-key
#   LLM_MODEL=gemini-2.5-flash
#
# Option 4 — Anthropic Claude (native SDK — leave LLM_BASE_URL unset;
#            claude-sonnet-4-6 / claude-haiku-4-5 are fastest for PR audits,
#            claude-opus-4-6 offers deepest reasoning):
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-sonnet-4-6
#
# Option 5 — Zero-AI Deterministic Mode:
#   Leave both LLM_BASE_URL and ANTHROPIC_API_KEY unset.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192

# --- Neon Postgres + pgvector (Semantic Memory & Audit Persistence) ---
# Optional in LOCAL_SANDBOX_MODE=true; REQUIRED in production.
DATABASE_URL=
# Automatically enabled for non-localhost DATABASE_URL; set true/false to override.
DATABASE_SSL=
# Optional Voyage AI embeddings key; falls back to local deterministic 1024-dim embeddings if unset.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# --- Fly.io Sprites (Hardware-Isolated MicroVM Sandboxes) ---
# Set SPRITES_TOKEN (or FLY_API_TOKEN) for production Fly Sprites execution.
SPRITES_TOKEN=
FLY_API_TOKEN=
SPRITES_API_URL=https://api.sprites.dev
SPRITE_NAME_PREFIX=sg
SPRITE_TTL_HOURS=72
SPRITE_ENFORCE_EGRESS_POLICY=true
SPRITE_EGRESS_ALLOWLIST=registry.npmjs.org,registry.yarnpkg.com,pypi.org,files.pythonhosted.org,github.com,codeload.github.com,objects.githubusercontent.com,nodejs.org

# --- GitHub Webhook & Split Connectors ---
# In production, provide either:
#   Option A (Recommended): GitHub App (issues down-scoped read-only & write tokens separately)
#   Option B: Distinct GITHUB_READ_TOKEN and GITHUB_WRITE_TOKEN fine-grained PATs
GITHUB_WEBHOOK_SECRET=spriteguard-local-dev-secret
GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_READ_TOKEN=
GITHUB_WRITE_TOKEN=
GITHUB_BOT_LOGIN=spriteguard[bot]
# Minimum repository permission required to execute `/spriteguard approve` (admin | maintain | write)
APPROVER_MIN_PERMISSION=maintain

# --- Audit Guardrails ---
AUDIT_INSTALL_TIMEOUT_SEC=600
AUDIT_TEST_TIMEOUT_SEC=600
MAX_CONCURRENT_AUDITS=2
MAX_DIFF_CHARS=120000
AUTO_PATCH=true
